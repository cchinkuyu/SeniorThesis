              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino.Geometry as rg
import rhinoscriptsyntax as rs

class VisualizePath(component):
    def RunScript(self, tool, tcf_plane, planes,i, thickness):
        self.t = thickness
        self.lines=[]
        polylines=[]
        color = System.Drawing.Color.DarkBlue
        
        # Safety checks
        if not planes or not tool or i is None or i==0.0:
            oriented_mesh = None
            polyline = None
        else:
            count = len(planes)
            
            # Clamp slider to [0.0, 1.0]
            i = max(0.0, min(1.0, i))
        
            # Remap slider to index
            index = int(i * (count - 1))
        
            # Get the target plane
            target_plane = planes[index]
        
            # Build polyline from plane origins up to and including the index
            poly_points = [p.Origin for p in planes[:index + 1]]
            polyline = rg.Polyline(poly_points).ToPolylineCurve()
        
            # Orient the tool
            xform = rg.Transform.PlaneToPlane(tcf_plane, target_plane)
        
            # Duplicate mesh and transform it
            oriented_mesh = tool.DuplicateMesh()
            oriented_mesh.Transform(xform)
            polylines.append(polyline)
            if polyline:
                self.lines.append((polyline, color))
        return polylines, oriented_mesh

    def DrawViewportWires(self, arg):
        if len(self.lines)!=0:
            for line, color in self.lines:
                arg.Display.DrawCurve(line, color, self.t)

</item>
