            <chunk name="Object" index="105">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">COMPAS FAB: Inverse Kinematics</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""
Calculate the robot's inverse kinematic for a given plane.

COMPAS FAB v1.0.2
"""

from compas_rhino.conversions import plane_to_compas_frame
from ghpythonlib.componentbase import executingcomponent as component



class MultipleInverseKinematics(component):
    def RunScript(self, robot, planes, start_configuration, group, compute):
    
        configurations = []
        if robot and robot.client and robot.client.is_connected and planes:
            for plane in planes:
                frame = plane_to_compas_frame(plane)
                config = robot.inverse_kinematics(frame, start_configuration, group)
                configurations.append(config)
                start_configuration = config
            
        return configurations
</item>
                    <item name="Description" type_name="gh_string" type_code="10">Calculate the robot's inverse kinematic for a given plane.
COMPAS FAB v1.0.2</item>
