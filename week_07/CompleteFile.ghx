                  <items count="14">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import os
import math

from compas.rpc import Proxy
package_path = ghdoc.Path
path = os.path.abspath(os.path.join(package_path,"../robot"))

if start_teach_mode:   
    canvas = ghenv.Component.OnPingDocument()
#    path = os.path.abspath(os.path.dirname(canvas.FilePath))
    rtde = Proxy('fabrication', path=path)                         # stay in teach moded(freedrive) as long as this is True
    a = rtde.start_teach_mode(ip=ip)            # send message to robot
    ghenv.Component.Message = "Freedrive on"    # display message on GH component

if stop_teach_mode:   
    canvas = ghenv.Component.OnPingDocument()
    print (path)
    rtde = Proxy('fabrication', path=path)                          # stop teach mode if stop button pressed
    a = rtde.stop_teach_mode(ip=ip)             # send message to robot   
    ghenv.Component.Message = "Freedrive off"   # display message on GH component



</item>
