                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math
import Grasshopper
from compas_fab.robots.robot import Joint
from compas_fab.robots.robot import Configuration

if robot:
    joints = robot.get_configurable_joints()
    joint_types = [joint.type for joint in joints]
    joint_names = [joint.name for joint in joints]
    
    joint_positions = [ 
                        math.radians(shoulder_pan), math.radians(shoulder_lift), 
                        math.radians(elbow), math.radians(wrist_1), 
                        math.radians(wrist_2), math.radians(wrist_3)]
    
    full_configuration = Configuration(joint_positions, joint_types, joint_names)
    
print(full_configuration)
</item>
