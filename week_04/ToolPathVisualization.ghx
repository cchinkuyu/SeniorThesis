            <chunk name="Object" index="187">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from Rhino.Geometry import Rectangle3d
import Rhino.Geometry as rg
import ghpythonlib.treehelpers as th
import copy

paths =[] # a nested list of planes

y=0
for rect in rectangles:
    path =[]
    for i in range (4):
        plane = rg.Plane(rect.Corner(i),-rg.Vector3d.ZAxis)
        path.append(plane)
    path.append(rg.Plane(rect.Corner(0),-rg.Vector3d.ZAxis))
    action = ["draw", path, colors[y]]
    paths.append(action)
    
    move_path=[]
    safe_pt = rect.Corner(0)
#    move_path.append(rg.Plane(safe_pt,-rg.Vector3d.ZAxis))
    safe_pt.Z += 0.1
    move_path.append(rg.Plane(safe_pt,-rg.Vector3d.ZAxis))
    
        
    if y!= len(rectangles)-1:
        
        if y&gt;0 and colors[y]!= colors[y+1]:
            pt_color = colorBuckets[colors[y+1]]
            safe_pt_color = copy.deepcopy(pt_color)
            safe_pt_color.Z += 0.1
            move_path.append(rg.Plane(safe_pt_color,-rg.Vector3d.ZAxis))
            move_path.append(rg.Plane(pt_color,-rg.Vector3d.ZAxis))
            move_path.append(rg.Plane(safe_pt_color,-rg.Vector3d.ZAxis))
#            y+=1
#            continue
            
        safe_pt = rectangles[y+1].Corner(0)
        safe_pt.Z += 0.1
        move_path.append(rg.Plane(safe_pt,-rg.Vector3d.ZAxis))
        
        action = ["move", move_path, -1]
        paths.append(action)
    y+=1

#paths = th.list_to_tree (paths)</item>
