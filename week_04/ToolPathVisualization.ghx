            <chunk name="Object" index="62">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import Rhino.Geometry as rg
import random

planes_to_check = []
# Ensure the input list is valid
if not planes or len(planes) &lt; 3:
    closest = None
    furthest = None
    random_planes = []
else:
    origin = rg.Point3d.Origin

    # Sort planes based on the distance from origin to the plane's origin
    planes_sorted = sorted(planes, key=lambda p: p.Origin.DistanceTo(origin))

    # Get closest and furthest
    closest = planes_sorted[0]
    furthest = planes_sorted[-1]

    # Select a random plane that is not the closest or furthest
    middle_planes = [p for p in planes if p != closest and p != furthest]
    
# If not enough middle planes, allow repetition or reduce number
    if len(middle_planes) &gt;= num_mid_planes:
        random_planes = random.sample(middle_planes, num_mid_planes)
    elif len(middle_planes) &gt; 0:
        num_mid_planes = len(middle_planes)
        random_planes = random.sample(middle_planes, k=num_mid_planes)
    else:
        # Fallback: pick from all if only 2 planes exist
        random_planes = random.choices(planes, k=num_mid_planes)

planes_to_check.append(furthest)
planes_to_check.append(closest)
planes_to_check.extend(random_planes)</item>
