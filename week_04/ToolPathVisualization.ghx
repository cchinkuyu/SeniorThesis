                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import ghpythonlib.components as ghcomp
import compas_fab
from compas_fab.robots.robot import Configuration

def remap(value, source_min, source_max, target_min, target_max):

    normalized_value = (value - source_min) / (source_max - source_min)
    
    remapped_value = target_min + normalized_value * (target_max - target_min)
    
    return remapped_value

def trajectory_points_to_configs(trajectory_points):
    configs = [] 
    for trajectory_point in trajectory_points:
        joint_values = list(trajectory_point.values())
        config = Configuration(joint_values, [0,0,0,0,0,0])
        configs.append(config)
    return configs

if isinstance(selected, list) and all(isinstance(t, compas_fab.robots.trajectory.JointTrajectory) for t in selected):
        # Flatten all trajectory points from all JointTrajectory objects
        all_points = []
        for traj in selected:
            all_points.extend(traj.points)
        print len (all_points)
        # Convert to configurations
        configs = trajectory_points_to_configs(all_points)

        # Remap index
        index = int(remap(i, 0.001, 1.00, 0, len(configs) - 1))
        index = min(max(0, index), len(configs) - 1)
        result = configs[index]
elif isinstance(selected,list ) and all(isinstance(c, Configuration) for c in selected):
    
    index = int(remap(i, 0.001, 1.00, 0, len(selected) - 1))
    index = min(max(0, index), len(selected) - 1)
    result = selected[index]
else:
    result = None  


config = result


