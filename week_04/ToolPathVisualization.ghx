              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">from ghpythonlib.componentbase import executingcomponent as component
import Grasshopper, GhPython
import System
import Rhino.Geometry as rg
import rhinoscriptsyntax as rs

class VisualizePath(component):
    def RunScript(self, tool, tcf_plane, paths, i, thickness):

        self.t = max(1, int(thickness) if thickness is not None else 2)
        self.lines = []
        polylines = []
        all_pts=[]

        # Colors
        draw_colors = [ System.Drawing.Color.DarkOliveGreen, System.Drawing.Color.DarkOrange,System.Drawing.Color.DarkBlue]
        move_color = System.Drawing.Color.Gray

        # Safety checks
        if not tool or tcf_plane is None or paths is None or i is None:
            return [], None

        # Validate and prepare groups
        groups = []  #  (action, planes_list)

        try:
            for entry in paths:
                if not isinstance(entry, (list, tuple)) or len(entry) != 3:
                    continue
                action, plist, asign_color = entry[0], entry[1], draw_colors[entry[2]]
                
                action_str = str(action).strip().lower()
                if action_str not in ("draw", "move"):
                    # Unknown action ----&gt;&gt;&gt; treat as travel
                    action_str = "move"
                # Ensure planes list
                if plist is None:
                    plist = []
                groups.append((action_str, list(plist), asign_color))
        except:
            return [], None
            
        group_ranges = []  
        total_count = 0
        for action, plist, asign_color in groups:
            n = len(plist)
            if n &lt;= 0:
                continue
            start = total_count
            end = total_count + n - 1
            group_ranges.append((action, start, end, plist, asign_color))
            total_count += n

        if total_count == 0:
            return [], None

        # Clamp and map slider i -&gt; global index across all planes
        i = max(0.0, min(1.0, float(i)))
        global_index = int(round(i * (total_count - 1)))

        # Determine target plane at global_index
        target_plane = None
        for action, start, end, plist, asign_color in group_ranges:
            if start &lt;= global_index &lt;= end:
                local_idx = global_index - start
                target_plane = plist[local_idx]
                break

        if target_plane is None:
            return [], None
        
        # Build colored polylines up to the current index, per group
        for action, start, end, plist, asign_color in group_ranges:
            if global_index &lt; start:
                continue

            upto = min(global_index, end)
            take_count = (upto - start) + 1
            pts = [p.Origin for p in plist[:take_count]] if take_count &gt; 0 else []
            all_pts.extend(pts)
            if len(pts) &gt;= 2:
                plc = rg.Polyline(pts).ToPolylineCurve()
                polylines.append(plc)
                color = asign_color if action == "draw" else move_color
                self.lines.append((plc, color, action))

        # Orient the mesh to the target plane
        try:
            xform = rg.Transform.PlaneToPlane(tcf_plane, target_plane)
            oriented_mesh = tool.DuplicateMesh()
            oriented_mesh.Transform(xform)
        except:
            oriented_mesh = None

        return oriented_mesh, polylines, all_pts

    def DrawViewportWires(self, arg):
        if self.lines:
            for crv, color, action in self.lines:
                if action=="draw":
                    arg.Display.DrawCurve(crv, color, self.t)
                else:
                    arg.Display.DrawCurve(crv, color, self.t/2)
</item>
