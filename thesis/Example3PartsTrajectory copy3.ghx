                      <Y>1747.036</Y>
                    </item>
                    <item name="Description" type_name="gh_string" type_code="10">A quick note</item>
                    <item name="Font" type_name="gh_string" type_code="10">Arial</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">dd652f02-5649-4103-8274-b6ee8fdfb568</item>
